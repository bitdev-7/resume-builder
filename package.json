{
  "name": "resume-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w resume-backend\" \"npm run dev -w resume-frontend\"",
    "dev:frontend": "npm run dev -w resume-frontend",
    "dev:backend": "npm run dev -w resume-backend",
    "build": "npm run build -w resume-backend && npm run build -w resume-frontend",
    "start:frontend": "npm run start -w resume-frontend",
    "start:backend": "npm run start -w resume-backend",
    "pm2": "npm run build && pm2 start ecosystem.config.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:redeploy": "npm run build && pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vitest": "^2.1.9"
  }
}
